<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventory Application</title>
  <link rel="stylesheet" href="/output.css">
  <script src="/index.js" defer></script>
</head>

<body>
  <!-- global components start -->
  <%-include('partials/forms-for-mobile/editFormSmallScreen')%>
  <!-- overlay -->
  <%- include('partials/overlay')%>
  <!-- global components end-->
  <%- include('partials/header')%>
  <!-- Select Category -->
  <%-include('partials/selectCategory')%>

  <!-- Items Table From Server -->
  <div id="items-div">
    <% if(items.length === 0 ) { %>
    <h1 class="bg-yellow-300">No items in this Category</h1>
    <%} else { %>
    <table class="table-auto mt-3 w-full border border-primary-dark lg:text-lg  ">
      <thead class="bg-primary-dark text-white">
        <tr>
          <th class="text-start">Id</th>
          <th class="text-start">Name</th>
          <th class="text-start">Price</th>
          <th class="text-start">Quantity</th>
        </tr>
      </thead>

      <tbody>

        <% items.forEach(item=>{ %>
        <tr class="border border-primary-dark odd:bg-white even: bg-green-100 ">
          <td class="p-1"><%=item.id%></td>
          <td class="p-1 pl-0"><%= item.name %></td>
          <td class="p-1 pl-0">$<%= (item.price/100).toFixed(2) %></td>
          <td class="p-1 pl-0"><%= item.quantity %> pcs</td>
        </tr>
        <% }) %>
        <%}%>
</tbody>
</table>
</div>
</body>

</html>