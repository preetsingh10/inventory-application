<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventory Application</title>
  <link rel="stylesheet" href="/output.css">
  <script src="/index.js" defer></script>
  <script src="/edit.js" defer></script>
    <script src="htmx.js"></script>
</head>

<body>
  <!-- ********************************************** Global Components Start **********************************************  -->
  <%-include('partials/forms-for-mobile/editFormSmallScreen')%>
  <!-- overlay -->
  <%- include('partials/overlay')%>
  <!-- Large screen forms -->
  <%- include('partials/editFormLargeScreen')%>
  <!--Edit Category Form-->
  <%- include('partials/edit-forms-for-mobile/edit-category' )%>

  <!-- Delete Category Form-->
  <%- include('partials/edit-forms-for-mobile/delete-category')%>

  <!-- ######################### Forms For Large Screen #########################  -->

  <%- include('partials/forms-for-desktop/addItem')%>

  <!-- ********************************************** Global Components End **********************************************  -->

  <%- include('partials/header')%>
  <!--Buttons For Large Screen -->
  <div class="flex gap-2 mt-2">
    <%-include('partials/desktopButtons/addCategoryButton')%>
    <%- include('partials/desktopButtons/addItemButton')%>
  </div>


  <div id="list-of-categories" class="flex flex-col gap-2 mt-2 px-5">
    <% categories.forEach(category=>{ %>
    <!-- parent categoy div -->
    <div class=" relative border-2 border-primary-dark rounded-lg p-3">

      <div class="flex justify-between ">
        <div id="categoryHeading-<%=category.id%>" onclick="openItemsPanel('<%= category.id %>')" hx-get="category/data/<%= category.id %>" hx-trigger="click" hx-target="#categoryId-<%=category.id%>" 
        class=" flex hover:cursor-pointer font-bold text-primary-dark">
          <%=category.name%>
          <%- include('partials/svg/dropDown',{id:category.id})%>
        </div>
        <%-include('partials/edit/option',{category})%>

      </div>
      <!-- child items panel -->
      <div id="categoryId-<%=category.id%>" class="items-panel hidden">

      </div>
    </div>
    <%})%>
  </div>


  <!-- ** Add Button ** -->
  <%-include('partials/addButton')%>

</body>

</html>