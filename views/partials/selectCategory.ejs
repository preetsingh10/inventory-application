<div class="flex gap-2 mt-2">
<p class="font-bold text-primary-dark" >Category: </p>
<select id="select-category" class="border-3 border-primary-dark rounded-md p-1 text-primary-dark font-bold focus:border-primary outline-transparent ">
    <option value="" selected disabled >Select Category</option>
    <% categories.forEach(category=>{ %>
        <option value="<%= category.id%>"><%=category.name %></option>
    <% })%>
</select>

</div>