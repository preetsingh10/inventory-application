<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventory Application</title>
  <link rel="stylesheet" href="/output.css">
  <script src="htmx.js"></script>
  <script src="/index.js" defer></script>
</head>

<body>
  <!-- global components start -->
  <%-include('partials/forms-for-mobile/editFormSmallScreen')%>
  <!-- overlay -->
  <%- include('partials/overlay')%>
  <!-- global components end-->
  <%- include('partials/header')%>
  <!-- Select Category -->
  <%-include('partials/selectCategory')%>
  <!--  All categories in Card Shape -->
  <div class="grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] p-1 gap-1">
    <% categories.forEach(category => {%>
    <%-include('partials/categoryCard', {category})%>
    <% })  %>
  </div>
</body>

</html>