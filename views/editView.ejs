<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventory Application</title>
  <link rel="stylesheet" href="/output.css">
  <script src="/index.js" defer></script>
  <script src="/edit.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js" integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V" crossorigin="anonymous"></script>
</head>

<body class="lg:mx-10">
  <!-- global components start -->
  <%-include('partials/forms-for-mobile/editFormSmallScreen')%>
  <!-- overlay -->
  <%- include('partials/overlay')%>

  <!--Edit Category Form-->
  <%- include('partials/edit-forms-for-mobile/edit-category' )%>

  <!-- Delete Category Form-->
  <%- include('partials/edit-forms-for-mobile/delete-category')%>
  <!-- global components end-->
  <%- include('partials/header')%>

  <div id="list-of-categories" class="flex flex-col gap-2 p-2  ">
    <% categories.forEach(category=>{ %>
    <!-- parent categoy div -->
    <div class="border-2 border-primary-dark rounded-lg p-3">

      <div class="flex justify-between ">
        <div id="categoryHeading-<%=category.id%>" onclick="openItemsPanel('<%= category.id %>')" 
        hx-get="category/data/<%= category.id %>" 
        hx-trigger="click" 
        hx-target="#categoryId-<%=category.id%>" 
        class="flex hover:cursor-pointer font-bold text-primary-dark">
          <%=category.name%>
          <%- include('partials/svg/dropDown',{id:category.id})%>
        </div>
        <div class="flex gap-4">
          <%-include('partials/svg/edit', {category})%>
          <%-include('partials/svg/delete', {category})%>
        </div>
      </div>
      <!-- child items panel -->
      <div id="categoryId-<%=category.id%>" class="items-panel hidden">

      </div>
    </div>
    <%})%>
  </div>


<!-- Add Button -->
<%-include('partials/addButton')%>
</body>

</html>